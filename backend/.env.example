# Database URL (SQLAlchemy). SQLite by default; swap for Postgres later, e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/chopthebill
DATABASE_URL=sqlite:///./chopthebill.db

# Secret for JWT signing. Generate one for real use, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
CHOPTHEBIL_SECRET=dev-only-secret-change-me-please-32
